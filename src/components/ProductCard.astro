---
// Recibimos los datos como propiedades (props)
const { nombre, precio, categoria } = Astro.props;
---
<article class="group cursor-pointer flex flex-col">
  <!-- Contenedor de la imagen con efecto zoom -->
  <div class="w-full aspect-square bg-stone-200 mb-6 overflow-hidden relative flex items-center justify-center">
    <div class="absolute inset-0 bg-[#ddc84d]/0 group-hover:bg-[#ddc84d]/10 transition-colors duration-500 z-10 pointer-events-none"></div>
    
    <span class="text-stone-400 font-serif italic tracking-widest group-hover:scale-110 transition-transform duration-700">Foto {categoria}</span>
  </div>
  
  <!-- Info de la joya -->
  <div class="flex flex-col items-center text-center">
    <span class="text-[10px] text-stone-500 uppercase tracking-[0.2em] mb-2">{categoria}</span>
    <h3 class="font-serif text-lg text-stone-900 mb-2">{nombre}</h3>
    <span class="text-sm font-semibold tracking-wider">{precio} €</span>
  </div>
</article>