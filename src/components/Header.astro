---
// Componente Header Adaptativo
---

<div class="fixed top-0 w-full z-50">
  <div
    class="bg-stone-900 text-[#ddc84d] text-[9px] tracking-[0.3em] uppercase text-center py-2.5 flex justify-center items-center space-x-6 md:space-x-8 w-full border-b border-stone-800 px-4"
  >
    <span class="font-light text-center">Envío asegurado 24/48h</span>
    <span class="hidden md:inline text-stone-600">|</span>
    <span class="hidden md:inline font-light">Oro 18K Certificado</span>
    <span class="hidden md:inline text-stone-600">|</span>
    <span class="hidden md:inline font-light">Transacción Cifrada</span>
  </div>

  <nav
    class="w-full py-4 sm:py-6 px-4 sm:px-10 flex flex-col sm:flex-row justify-between items-center bg-stone-50/95 backdrop-blur-md border-b border-stone-200 shadow-sm gap-3 sm:gap-0"
  >
    <div
      class="text-xl sm:text-2xl font-serif tracking-[0.2em] uppercase flex items-center gap-2"
    >
      <a
        href="/"
        class="font-bold text-stone-900 hover:text-[#ddc84d] transition-colors"
        >LA BOUTIQUE</a
      >
    </div>

    <!-- Enlaces: hemos añadido px-3 py-2 para que el área de "clic" sea más grande para los dedos -->
    <ul
      class="flex text-[10px] sm:text-xs tracking-widest uppercase text-stone-600 font-semibold items-center"
    >
      <li>
        <a
          href="/catalogo"
          class="block px-3 py-2 rounded-lg hover:text-[#ddc84d] active:bg-stone-200/50 active:scale-95 active:text-[#ddc84d] transition-all duration-150"
          >Colección</a
        >
      </li>

      <li>
        <a
          href="/pulseras"
          class="block px-3 py-2 rounded-lg hover:text-[#ddc84d] active:bg-stone-200/50 active:scale-95 active:text-[#ddc84d] transition-all duration-150"
          >Pulseras</a
        >
      </li>

      <li>
        <a
          href="/cadenas"
          class="block px-3 py-2 rounded-lg hover:text-[#ddc84d] active:bg-stone-200/50 active:scale-95 active:text-[#ddc84d] transition-all duration-150"
          >Cadenas</a
        >
      </li>
    </ul>
  </nav>
</div>
