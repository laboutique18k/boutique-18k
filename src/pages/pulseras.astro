---
import MainLayout from '../layouts/MainLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productos from '../data/productos.json';

// Lógica JS: Filtramos el array para quedarnos solo con las pulseras
const pulseras = productos.filter(joya => joya.categoria === 'Pulseras');
---

<MainLayout>
  <main class="pt-32 pb-20 px-10 max-w-7xl mx-auto min-h-screen">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-serif font-light mb-4 uppercase">Pulseras de Oro</h1>
      <p class="text-stone-500 max-w-xl mx-auto">
        Elegancia en cada movimiento. Piezas atemporales forjadas en oro de 18 quilates.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {pulseras.map((joya) => (
        <a href={`/joyas/${joya.id}`} class="block">
          <ProductCard nombre={joya.nombre} precio={joya.precio} categoria={joya.categoria} />
        </a>
      ))}
    </div>
  </main>
</MainLayout>