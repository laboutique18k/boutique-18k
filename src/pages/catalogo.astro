---
import MainLayout from '../layouts/MainLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productos from '../data/productos.json';

// Lógica JS: Buscamos un producto representativo de cada categoría
const masVendidos = [
  productos.find(joya => joya.categoria === 'Cadenas'),
  productos.find(joya => joya.categoria === 'Pulseras')
];
---

<MainLayout>
  <main class="pt-32 pb-20 px-10 max-w-7xl mx-auto min-h-screen">
    <div class="text-center mb-16">
      <h2 class="text-[#ddc84d] text-xs tracking-[0.3em] font-bold mb-4 uppercase">Piezas Destacadas</h2>
      <h1 class="text-4xl font-serif font-light mb-4 uppercase">Los Más Vendidos</h1>
      <p class="text-stone-500 max-w-xl mx-auto">
        Una cuidada selección de nuestras piezas de oro 18K más codiciadas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {masVendidos.map((joya) => (
        <a href={`/joyas/${joya.id}`} class="block">
          <ProductCard nombre={joya.nombre} precio={joya.precio} categoria={joya.categoria} />
        </a>
      ))}
    </div>
  </main>
</MainLayout>