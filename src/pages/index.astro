---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <!-- Cambiamos a flex-col en móvil y flex-row (lg:flex-row) en escritorio -->
  <main class="w-full min-h-screen flex flex-col lg:flex-row pt-24 lg:pt-0">
    <!-- Columna Izquierda (Texto y Acción) -->
    <div
      class="w-full lg:w-1/2 flex flex-col justify-center px-8 lg:px-24 py-12 lg:py-0 z-10"
    >
      <h2
        class="text-[#ddc84d] text-xs lg:text-sm tracking-[0.3em] font-bold mb-4 uppercase"
      >
        Joyeria de piezas de oro 18K
      </h2>
      <h1 class="text-5xl lg:text-7xl font-serif font-light leading-tight mb-8">
        Elegancia <br />
        <span class="italic font-normal text-stone-500">Atemporal.</span>
      </h1>
      <p
        class="text-base lg:text-lg text-stone-600 mb-10 max-w-md leading-relaxed"
      >
        La mejor calidad con garantía. Piezas exclusivas diseñadas para perdurar
        de generación en generación.
      </p>
      <!-- Botón que se ajusta a su contenido (w-fit) -->
      <!-- Enlace con aspecto de botón -->
      <a
        href="/catalogo"
        class="bg-stone-900 text-white px-8 py-4 tracking-widest uppercase text-xs active:scale-95 active:bg-stone-800 transition-all duration-200 inline-block"
      >
        Descubrir Colección
      </a>
    </div>

    <!-- Columna Derecha (Imagen) -->
    <div
      class="w-full lg:w-1/2 min-h-[50vh] lg:min-h-screen bg-[#ddc84d]/5 border-t lg:border-t-0 lg:border-l border-[#ddc84d]/20 flex items-center justify-center p-8 lg:p-0"
    >
      <!-- EL CAMBIO ESTÁ AQUÍ: Pasamos de max-w-md a max-w-2xl para hacerla gigante y majestuosa -->
      <div
        class="w-full max-w-2xl aspect-square border border-[#ddc84d] p-4 md:p-6 relative"
      >
        <img
          src="/images/Portada.png"
          alt="Cadena de Oro 18K"
          class="w-full h-full object-cover shadow-sm"
        />
      </div>
    </div>
  </main>
</MainLayout>
